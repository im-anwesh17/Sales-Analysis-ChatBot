# Application Settings
PROJECT_NAME="AI Sales Analytics Chatbot API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Settings
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/sales_analytics
# Default fallback: sqlite:///./sales_analytics.db
DATABASE_URL="sqlite:///./sales_analytics.db"

# AI Provider Settings
# Options: "gemini" or "openai"
AI_PROVIDER="gemini"

# API Keys
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Model Selection
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_MODEL="gpt-4o-mini"
